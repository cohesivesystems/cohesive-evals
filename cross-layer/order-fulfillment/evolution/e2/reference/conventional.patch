+namespace Fulfillment.Application;
+
+// Typed projection tables; the orchestration only decides when to project.
+public static class FulfillmentResults
+{
+    public static Completion FromStock(StockOutcome outcome) => new("Rejected", outcome switch
+    {
+        StockOutcome.InvalidQuantity => "InvalidQuantity",
+        StockOutcome.QuantityLimitExceeded => "QuantityLimitExceeded",
+        StockOutcome.InsufficientStock => "InsufficientStock",
+        _ => throw new InvalidOperationException("Unexpected stock rejection.")
+    });
+
+    public static Completion FromSubmission(SubmissionOutcome? outcome) => new("Rejected", outcome switch
+    {
+        SubmissionOutcome.OrderCancelled => "OrderCancelled",
+        SubmissionOutcome.NotDraft => "OrderRejected",
+        _ => throw new InvalidOperationException("Unexpected submission rejection.")
+    });
+}
