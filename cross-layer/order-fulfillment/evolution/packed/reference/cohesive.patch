+    // These bodyless commands can safely rerun the decision after a failed compare-and-swap.
+    // Retry only the SDK's pre-commit concurrency result; never retry a domain rejection.
+    static async ValueTask<object?> RetryConcurrentOrderCommand(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        while (true)
+        {
+            context.HttpContext.RequestAborted.ThrowIfCancellationRequested();
+            var result = await next(context);
+            if (result is not Microsoft.AspNetCore.Http.HttpResults.ProblemHttpResult problem ||
+                !problem.ProblemDetails.Extensions.TryGetValue("code", out var code) ||
+                !Equals(code, ApiProblemCodes.ConcurrencyConflict))
+                return result;
+        }
     }
 
