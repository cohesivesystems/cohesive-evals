 namespace Fulfillment.Application;
 
-public enum OrderStatus { Draft, Submitted, Cancelled }
-public sealed record Order(string Id, OrderStatus Status);
+public enum OrderStatus { Draft, Submitted, Cancelled, Packed }
+public sealed record Order(string Id, OrderStatus Status)
+{
+    public Order? Apply(OrderCommand command)
+    {
+        var machine = new Stateless.StateMachine<OrderStatus, OrderCommand>(Status);
+        machine.Configure(OrderStatus.Draft)
+            .Permit(OrderCommand.Submit, OrderStatus.Submitted)
+            .Permit(OrderCommand.Cancel, OrderStatus.Cancelled);
+        machine.Configure(OrderStatus.Submitted)
+            .Permit(OrderCommand.Pack, OrderStatus.Packed)
+            .Ignore(OrderCommand.Unpack);
+        machine.Configure(OrderStatus.Packed)
+            .Permit(OrderCommand.Unpack, OrderStatus.Submitted)
+            .Ignore(OrderCommand.Pack);
+        machine.Configure(OrderStatus.Cancelled).Ignore(OrderCommand.Cancel);
+        if (!machine.CanFire(command)) return null;
+        machine.Fire(command);
+        return this with { Status = machine.State };
+    }
+}
