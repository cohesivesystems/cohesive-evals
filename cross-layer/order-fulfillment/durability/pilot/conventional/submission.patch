@@ -0,0 +1,33 @@
+namespace Fulfillment.Application;
+
+internal static class EvaluationHooks
+{
+    public static async Task CrashAt(string point)
+    {
+        if (Environment.GetEnvironmentVariable("EVAL_CRASH_POINT") != point)
+            return;
+
+        var marker = Environment.GetEnvironmentVariable("EVAL_CRASH_MARKER")
+            ?? throw new InvalidOperationException("Missing crash marker path.");
+        await File.WriteAllTextAsync(marker, point);
+        await Task.Delay(Timeout.InfiniteTimeSpan);
+    }
+
+    public static void FailBeforeReserve()
+    {
+        if (Environment.GetEnvironmentVariable("EVAL_FAIL_POINT") != "before-reserve")
+            return;
+
+        var marker = Environment.GetEnvironmentVariable("EVAL_FAIL_MARKER")
+            ?? throw new InvalidOperationException("Missing failure marker path.");
+        try
+        {
+            using var file = new FileStream(marker, FileMode.CreateNew, FileAccess.Write);
+        }
+        catch (IOException) when (File.Exists(marker))
+        {
+            return;
+        }
+        throw new InvalidOperationException("Injected failure before reserve.");
+    }
+}
