diff --git a/src/Fulfillment.Application/FulfillmentWorkflow.cs b/src/Fulfillment.Application/FulfillmentWorkflow.cs
new file mode 100644
index 0000000..e247f41
--- /dev/null
+++ b/src/Fulfillment.Application/FulfillmentWorkflow.cs
@@ -0,0 +1,109 @@
+using Microsoft.DurableTask;
+using Microsoft.DurableTask.Client;
+using Microsoft.DurableTask.Client.AzureManaged;
+using Microsoft.DurableTask.Worker;
+using Microsoft.DurableTask.Worker.AzureManaged;
+
+namespace Fulfillment.Application;
+
+public sealed record Work(string OperationId, FulfillmentRequest Request);
+
+public static class FulfillmentWorkflow
+{
+    public const string Name = "FulfillOrder";
+    const string Inspect = "InspectOrder";
+    const string Reserve = "ReserveStock";
+    const string Submit = "SubmitOrder";
+    const string Record = "CreateReservation";
+    const string Release = "ReleaseStock";
+
+    public static void Configure(IServiceCollection services, string scheduler)
+    {
+        services.AddDurableTaskClient(client =>
+        {
+            client.UseDurableTaskScheduler(scheduler);
+            client.RegisterDirectly();
+        });
+        services.AddDurableTaskWorker(worker =>
+        {
+            worker.UseDurableTaskScheduler(scheduler);
+            worker.AddTasks(tasks =>
+            {
+                tasks.AddOrchestratorFunc<Work, Completion>(Name, Run);
+                tasks.AddActivity(Inspect, sp => new InspectActivity(sp.GetRequiredService<OrderStore>()));
+                tasks.AddActivity(Reserve, sp => new StockActivity(sp.GetRequiredService<OrderStore>(), release: false));
+                tasks.AddActivity(Submit, sp => new SubmitActivity(sp.GetRequiredService<OrderStore>()));
+                tasks.AddActivity(Record, sp => new ReservationActivity(sp.GetRequiredService<OrderStore>()));
+                tasks.AddActivity(Release, sp => new StockActivity(sp.GetRequiredService<OrderStore>(), release: true));
+            });
+        });
+    }
+
+    static async Task<Completion> Run(TaskOrchestrationContext context, Work work)
+    {
+        var preexisting = await context.CallActivityAsync<Completion?>(Inspect, work);
+        if (preexisting is not null) return preexisting;
+        var reserved = await context.CallActivityAsync<StockOutcome>(Reserve, work);
+        if (reserved is StockOutcome.InvalidQuantity or StockOutcome.InsufficientStock)
+            return new("Rejected", reserved.ToString());
+        if (reserved != StockOutcome.Reserved) throw new InvalidOperationException("Unknown reserve outcome.");
+        var submitted = await context.CallActivityAsync<SubmissionOutcome?>(Submit, work);
+        if (submitted == SubmissionOutcome.Submitted)
+        {
+            await context.CallActivityAsync<bool>(Record, work);
+            return new("Submitted", "ReservedAndSubmitted");
+        }
+        await context.CallActivityAsync<StockOutcome>(Release, work);
+        return new("Rejected", "OrderRejected");
+    }
+
+    sealed class InspectActivity(OrderStore store) : TaskActivity<Work, Completion?>
+    {
+        public override async Task<Completion?> RunAsync(TaskActivityContext context, Work work)
+        {
+            var request = work.Request;
+            var order = await store.Order(request.OrderId);
+            if (order is null) return new("Rejected", "OrderMissing");
+            var existing = await store.Reservation(request.OrderId);
+            if (existing is not null)
+                return existing.OrderId == request.OrderId && existing.Sku == request.Sku
+                    && existing.Quantity == request.Quantity && order.Status == OrderStatus.Submitted
+                    ? new("Submitted", "ReservedAndSubmitted") : new("Rejected", "ReservationConflict");
+            return await store.Inventory(request.Sku) is null ? new("Rejected", "InventoryMissing") : null;
+        }
+    }
+
+    sealed class StockActivity(OrderStore store, bool release) : TaskActivity<Work, StockOutcome>
+    {
+        public override async Task<StockOutcome> RunAsync(TaskActivityContext context, Work work)
+        {
+            if (!release) EvaluationHooks.FailBeforeReserve();
+            var step = release ? "release" : "reserve";
+            var result = await store.Stock(work.Request.Sku, work.Request.Quantity, release, work.OperationId + "/" + step);
+            await EvaluationHooks.CrashAt("after-" + step);
+            return result;
+        }
+    }
+
+    sealed class SubmitActivity(OrderStore store) : TaskActivity<Work, SubmissionOutcome?>
+    {
+        public override async Task<SubmissionOutcome?> RunAsync(TaskActivityContext context, Work work)
+        {
+            var result = await store.Submit(work.Request.OrderId, work.OperationId + "/submit");
+            await EvaluationHooks.CrashAt("after-submit");
+            return result;
+        }
+    }
+
+    sealed class ReservationActivity(OrderStore store) : TaskActivity<Work, bool>
+    {
+        public override async Task<bool> RunAsync(TaskActivityContext context, Work work)
+        {
+            var request = work.Request;
+            var result = await store.CreateReservation(new(request.OrderId, request.OrderId, request.Sku, request.Quantity),
+                work.OperationId + "/reservation");
+            await EvaluationHooks.CrashAt("after-reservation");
+            return result;
+        }
+    }
+}
