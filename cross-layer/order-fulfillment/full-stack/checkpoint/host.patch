@@ -0,0 +1,27 @@
+using System.Text.Json;
+
+namespace Fulfillment.Application;
+
+public sealed record ShippingState(string Id, string Status, bool Held, int Remaining)
+{
+    public static ShippingState From(Order order) =>
+        new(order.Id, order.Status.ToString(), order.ShippingHold, order.Remaining);
+}
+
+public sealed class ShippingQuantityInput : IEndpointFilter
+{
+    static readonly object Key = new();
+    public static ShipQuantity Get(HttpContext context) => (ShipQuantity)context.Items[Key]!;
+    public async ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        if (!context.HttpContext.Request.HasJsonContentType()) return Results.StatusCode(415);
+        try
+        {
+            var quantity = await context.HttpContext.Request.ReadFromJsonAsync<ShipQuantity>();
+            if (quantity is null) return Results.BadRequest();
+            context.HttpContext.Items[Key] = quantity;
+        }
+        catch (JsonException) { return Results.BadRequest(); }
+        return await next(context);
+    }
+}
