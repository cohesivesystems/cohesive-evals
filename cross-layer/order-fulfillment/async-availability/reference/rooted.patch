@@ -0,0 +1,39 @@
+using Cohesive.Adapters.Postgres;
+using Cohesive.Model.Serialization;
+using Cohesive.Storage.Materialization;
+
+namespace Fulfillment.Application;
+
+public static class AvailabilityStorage
+{
+    public static PostgresMaterializationStorage Bind(PostgresPersistenceBindings bindings, FulfillmentQueries queries)
+    {
+        const int page = 100;
+        const int bytes = 2_000_000;
+        var declaration = Materialization.Define(new("orders/availability"), queries.OrderDetailsRelation)
+            .WithUpdatePolicy(new(MaterializationSynchronizationMode.All, MaterializationConsistencyKind.BaselinePlusCatchUp,
+                MaterializationIdempotencyKind.StableOutputIdentityAndVersion))
+            .WithBoundedRelationBaselineCatchUpSources(5000, bytes, 5000, bytes)
+            .WithGenerationalIndexTarget(page, bytes)
+            .WithFailurePolicy(new(3, MaterializationFailureDisposition.Stop))
+            .WithFreshnessPolicy(new(maximumLagMilliseconds: 300_000))
+            .WithProvenance(new(new("orders/availability", "1"), new("orders/availability"), DocumentOrigin.Generated))
+            .Build().Prepare(new(new("orders/availability/impact"), [MaterializationImpactStrategyKind.InverseTraversal], 5000, bytes));
+        return new(bindings, declaration, new()
+        {
+            PartitionField = FulfillmentDomain.PartitionField,
+            Planning = new(new("orders/availability/physical"), "orders/availability/v1", page, 5000, 5000, page, page, 1),
+            Reads = new(page, 5000, page, bytes, partitionScope: new(new(FulfillmentStoragePolicy.LogicalPartition),
+                FulfillmentDomain.PartitionField, FulfillmentStoragePolicy.LocalPartition)),
+            Rebuild = new(page, bytes, page, bytes, 128, 1, 1, 16),
+            Publication = "availability_changes",
+            Slot = input => "availability_" + Convert.ToHexStringLower(System.Security.Cryptography.SHA256.HashData(
+                System.Text.Encoding.UTF8.GetBytes(input.Value)))[..16],
+            Replication = new(readInactivityTimeout: TimeSpan.FromSeconds(1)),
+            Checkpoints = new("orders/availability"),
+            Provider = "orders/availability",
+            Capacity = new(new("orders/worker"), 1, ["postgres-session-advisory-lock"]),
+            Provenance = new(new("orders/availability", "1"), new("orders/availability"))
+        });
+    }
+}
