{
  "conventional": [
    {
      "name": "zero-admitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": "quantity <= 0 ?",
      "after": "quantity < 0 ?"
    },
    {
      "name": "quarantine-omitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": ": item.Quarantined ? (item, StockOutcome.InventoryQuarantined)\n        ",
      "after": ""
    },
    {
      "name": "limit-omitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": ": quantity > item.MaxPerOrder ? (item, StockOutcome.QuantityLimitExceeded)\n        ",
      "after": ""
    },
    {
      "name": "stock-omitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": ": item.Available < quantity ? (item, StockOutcome.InsufficientStock)\n        ",
      "after": ""
    },
    {
      "name": "stock-too-strict",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": "item.Available < quantity ?",
      "after": "item.Available <= quantity ?"
    },
    {
      "name": "limit-too-strict",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": "quantity > item.MaxPerOrder ?",
      "after": "quantity >= item.MaxPerOrder ?"
    },
    {
      "name": "decrement-omitted",
      "assertion": "accepted delta",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": "Available = item.Available - quantity",
      "after": "Available = item.Available"
    },
    {
      "name": "reject-all",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": "quantity <= 0 ?",
      "after": "true ?"
    },
    {
      "name": "configuration-corrupted",
      "assertion": "accepted delta",
      "path": "src/Fulfillment.Application/Domain.cs",
      "before": "Available = item.Available - quantity",
      "after": "Available = item.Available - quantity, MaxPerOrder = 0"
    },
    {
      "name": "wrong-terminal",
      "assertion": "terminal outcome",
      "path": "src/Fulfillment.Application/FulfillmentResults.cs",
      "before": "StockOutcome.InvalidQuantity => \"InvalidQuantity\"",
      "after": "StockOutcome.InvalidQuantity => \"InsufficientStock\""
    }
  ],
  "cohesive": [
    {
      "name": "zero-admitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "                .Requires((item, input) => input.Quantity > 0,\n                    (_, _) => new StockResult(StockOutcome.InvalidQuantity, FulfillmentOutcome.InvalidQuantity))\n",
      "after": "                .Requires((item, input) => input.Quantity >= 0,\n                    (_, _) => new StockResult(StockOutcome.InvalidQuantity, FulfillmentOutcome.InvalidQuantity))\n"
    },
    {
      "name": "quarantine-omitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "                .Requires((item, input) => !item.Quarantined,\n                    (_, _) => new StockResult(StockOutcome.InventoryQuarantined, FulfillmentOutcome.InventoryQuarantined))\n",
      "after": ""
    },
    {
      "name": "limit-omitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "                .Requires((item, input) => input.Quantity <= item.MaxPerOrder,\n                    (_, _) => new StockResult(StockOutcome.QuantityLimitExceeded, FulfillmentOutcome.QuantityLimitExceeded))\n",
      "after": ""
    },
    {
      "name": "stock-omitted",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "                .Requires((item, input) => item.Available >= input.Quantity,\n                    (_, _) => new StockResult(StockOutcome.InsufficientStock, FulfillmentOutcome.InsufficientStock))\n",
      "after": ""
    },
    {
      "name": "stock-too-strict",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "item.Available >= input.Quantity,",
      "after": "item.Available > input.Quantity,"
    },
    {
      "name": "limit-too-strict",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "input.Quantity <= item.MaxPerOrder,",
      "after": "input.Quantity < item.MaxPerOrder,"
    },
    {
      "name": "decrement-omitted",
      "assertion": "accepted delta",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "item.Available - input.Quantity)",
      "after": "item.Available)"
    },
    {
      "name": "reject-all",
      "assertion": "domain outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "                .Requires((item, input) => input.Quantity > 0,\n                    (_, _) => new StockResult(StockOutcome.InvalidQuantity, FulfillmentOutcome.InvalidQuantity))\n",
      "after": "                .Requires((item, input) => input.Quantity > int.MaxValue,\n                    (_, _) => new StockResult(StockOutcome.InvalidQuantity, FulfillmentOutcome.InvalidQuantity))\n"
    },
    {
      "name": "configuration-corrupted",
      "assertion": "accepted delta",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": ".Set(new(\"stock/update\"), item => item.Available, (item, input) => item.Available - input.Quantity)",
      "after": ".Set(new(\"stock/update\"), item => item.Available, (item, input) => item.Available - input.Quantity)\n                .Set(new(\"fault/configuration\"), item => item.MaxPerOrder, (_, _) => 0)"
    },
    {
      "name": "wrong-terminal",
      "assertion": "terminal outcome",
      "path": "src/Fulfillment.Application/FulfillmentDomain.cs",
      "before": "                .Requires((item, input) => input.Quantity > 0,\n                    (_, _) => new StockResult(StockOutcome.InvalidQuantity, FulfillmentOutcome.InvalidQuantity))\n",
      "after": "                .Requires((item, input) => input.Quantity > 0,\n                    (_, _) => new StockResult(StockOutcome.InvalidQuantity, FulfillmentOutcome.InsufficientStock))\n"
    }
  ]
}
